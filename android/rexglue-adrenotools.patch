diff --git a/src/ui/vulkan/vulkan_instance.cpp b/src/ui/vulkan/vulkan_instance.cpp
index 0000000..0000000 100644
--- a/src/ui/vulkan/vulkan_instance.cpp
+++ b/src/ui/vulkan/vulkan_instance.cpp
@@ -15,6 +15,12 @@
 #include <utility>
 #include <vector>
 
+#if defined(__ANDROID__)
+#include <cstdlib>
+#include <dlfcn.h>
+#include <adrenotools/driver.h>
+#endif
+
 #include <rex/cvar.h>
 #include <rex/logging.h>
 #include <rex/platform.h>
@@ -39,5 +45,32 @@ std::unique_ptr<VulkanInstance> VulkanInstance::Create(const bool with_surface,
 
   bool functions_loaded = true;
   bool loader_loaded = false;
+#if defined(__ANDROID__)
+  const char* custom_driver_dir = std::getenv("REX_ADRENO_DRIVER_DIR");
+  const char* custom_driver_name = std::getenv("REX_ADRENO_DRIVER_NAME");
+  const char* hook_library_dir = std::getenv("REX_ADRENO_HOOK_DIR");
+  if (custom_driver_dir && custom_driver_name && hook_library_dir &&
+      custom_driver_dir[0] && custom_driver_name[0] && hook_library_dir[0]) {
+    vulkan_instance->adrenotools_loader_ = adrenotools_open_libvulkan(
+        RTLD_NOW | RTLD_LOCAL, ADRENOTOOLS_DRIVER_CUSTOM, nullptr, hook_library_dir,
+        custom_driver_dir, custom_driver_name, nullptr, nullptr);
+    if (vulkan_instance->adrenotools_loader_) {
+      ifn.vkGetInstanceProcAddr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+          dlsym(vulkan_instance->adrenotools_loader_, "vkGetInstanceProcAddr"));
+      ifn.vkDestroyInstance = reinterpret_cast<PFN_vkDestroyInstance>(
+          dlsym(vulkan_instance->adrenotools_loader_, "vkDestroyInstance"));
+      loader_loaded = ifn.vkGetInstanceProcAddr && ifn.vkDestroyInstance;
+      if (loader_loaded) {
+        REXLOG_INFO("Adreno Tools custom Vulkan driver selected: {}", custom_driver_name);
+      } else {
+        REXLOG_WARN("Adreno Tools did not expose required Vulkan loader symbols; using system driver");
+        dlclose(vulkan_instance->adrenotools_loader_);
+        vulkan_instance->adrenotools_loader_ = nullptr;
+      }
+    } else {
+      REXLOG_WARN("Adreno Tools could not open the selected driver; using system Vulkan driver");
+    }
+  }
+#endif
 #if REX_PLATFORM_MAC
   const MacOSVulkanRuntimePaths macos_runtime_paths = DetectMacOSVulkanRuntimePaths();
@@ -70,17 +95,26 @@ std::unique_ptr<VulkanInstance> VulkanInstance::Create(const bool with_surface,
   }
 #else
-  loader_loaded = vulkan_instance->loader_.Load(platform::lib_names::kVulkanLoader);
+  if (!loader_loaded) {
+    loader_loaded = vulkan_instance->loader_.Load(platform::lib_names::kVulkanLoader);
+  }
   if (!loader_loaded) {
     REXLOG_ERROR("Failed to load {}", platform::lib_names::kVulkanLoader);
     return nullptr;
   }
 #endif
 
+#if defined(__ANDROID__)
+  if (vulkan_instance->adrenotools_loader_) {
+    functions_loaded &= ifn.vkGetInstanceProcAddr != nullptr && ifn.vkDestroyInstance != nullptr;
+  } else
+#endif
+  {
 #define XE_VULKAN_LOAD_LOADER_FUNCTION(name) \
   functions_loaded &= (ifn.name = vulkan_instance->loader_.GetSymbol<PFN_##name>(#name)) != nullptr;
   XE_VULKAN_LOAD_LOADER_FUNCTION(vkGetInstanceProcAddr);
   XE_VULKAN_LOAD_LOADER_FUNCTION(vkDestroyInstance);
 #undef XE_VULKAN_LOAD_LOADER_FUNCTION
+  }
   if (!functions_loaded) {
     REXLOG_ERROR("Failed to get Vulkan loader function pointers");
     return nullptr;
@@ -430,5 +462,13 @@ VulkanInstance::~VulkanInstance() {
     functions_.vkDestroyInstance(instance_, nullptr);
   }
 
+#if defined(__ANDROID__)
+  if (adrenotools_loader_) {
+    dlclose(adrenotools_loader_);
+  } else {
+    loader_.Close();
+  }
+#else
   loader_.Close();
+#endif
 }
